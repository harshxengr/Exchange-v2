DATABASE_URL=postgresql://exchange:exchange@localhost:5432/exchange

REDIS_URL=redis://localhost:6379

API_PORT=4000

# Browser origins allowed to call the API.
# Use your deployed web origin in production.
CORS_ORIGIN=http://localhost:3000

# JWT signing secret. Use a random value of at least 32 characters in production.
JWT_SECRET=replace-with-a-random-32-plus-character-secret

JWT_EXPIRES_IN=1h

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# Shared secret for the optional external payout callback endpoint.
WITHDRAWAL_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Free local payout simulation.
# Modes: COMPLETE, FAIL, REVERSE
PAYOUT_PROVIDER=demo
DEMO_PAYOUT_MODE=COMPLETE
DEMO_PAYOUT_DELAY_MS=3000

# Allow the free demo provider when NODE_ENV=production.
# This keeps a resume/demo deployment fully local and cost-free.
ALLOW_DEMO_PAYOUTS_IN_PRODUCTION=true

# Generic HTTP payout provider (optional)
PAYOUT_PROVIDER_NAME=http-provider
PAYOUT_PROVIDER_URL=
PAYOUT_PROVIDER_API_KEY=
PAYOUT_PROVIDER_TIMEOUT_MS=10000
PAYOUT_POLL_MS=2000
PAYOUT_BASE_RETRY_MS=5000
PAYOUT_RECONCILE_MS=10000
PAYOUT_RECONCILE_COMPLETED_MS=30000
PAYOUT_MAX_ATTEMPTS=10
