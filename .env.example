DATABASE_URL=postgresql://exchange:exchange@localhost:5432/exchange

REDIS_URL=redis://localhost:6379

API_PORT=4000
WS_PORT=4001

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4001

AUTH_SECRET=replace-this-in-development

# Shared secret for external payout-provider callbacks.
# Set a strong random value in real environments.
WITHDRAWAL_WEBHOOK_SECRET=replace-this-with-a-strong-secret

# Free local payout simulation.
# No bank account, paid provider, or API key is required.
# Modes: COMPLETE, FAIL, REVERSE
PAYOUT_PROVIDER=demo
DEMO_PAYOUT_MODE=COMPLETE
DEMO_PAYOUT_DELAY_MS=3000

# Generic HTTP payout provider (optional)
PAYOUT_PROVIDER_NAME=http-provider
PAYOUT_PROVIDER_URL=
PAYOUT_PROVIDER_API_KEY=
PAYOUT_PROVIDER_TIMEOUT_MS=10000
PAYOUT_POLL_MS=2000
PAYOUT_BASE_RETRY_MS=5000
PAYOUT_RECONCILE_MS=10000
PAYOUT_MAX_ATTEMPTS=10

# Optional real-provider adapter for future integration.
# Not required for this resume project.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_PAYOUT_MODE=IMPS
RAZORPAYX_PAYOUT_PURPOSE=payout
RAZORPAYX_AMOUNT_MULTIPLIER=1
RAZORPAY_API_BASE_URL=https://api.razorpay.com
RAZORPAY_TIMEOUT_MS=10000
RAZORPAY_WEBHOOK_SECRET=
